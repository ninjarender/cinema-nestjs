### Cinema API — перевірка всіх маршрутів і помилок.
### Виконуйте запити по черзі згори вниз (розширення REST Client для VS Code).
### Ідентифікатори й токени підставляються з відповідей попередніх запитів через змінні.
### Перед запуском: міграції + `npm run seed` (створює адміністратора з ADMIN_EMAIL / ADMIN_PASSWORD).

@baseUrl = http://localhost:3000
@missingId = 00000000-0000-4000-8000-000000000000

# Мають збігатися з ADMIN_EMAIL і ADMIN_PASSWORD у .env
@adminEmail = admin@cinema.local
@adminPassword = admin-password-123

@userEmail = {{registerUser.response.body.$.email}}
@adminToken = {{loginAdmin.response.body.$.accessToken}}
@userToken = {{loginUser.response.body.$.accessToken}}
@userRefreshToken = {{loginUser.response.body.$.refreshToken}}
@rotatedRefreshToken = {{refreshUser.response.body.$.refreshToken}}
@otherToken = {{loginOther.response.body.$.accessToken}}
@otherRefreshToken = {{loginOther.response.body.$.refreshToken}}

@filmId = {{createFilm.response.body.$.id}}
@otherFilmId = {{createOtherFilm.response.body.$.id}}
@hallId = {{createHall.response.body.$.id}}
@hallName = {{createHall.response.body.$.name}}
@otherHallId = {{createOtherHall.response.body.$.id}}
@showingId = {{createShowing.response.body.$.id}}
@bookingId = {{createBooking.response.body.$.id}}
@otherBookingId = {{createOtherBooking.response.body.$.id}}


######################## АВТЕНТИФІКАЦІЯ ########################

### Реєстрація → 201, роль user (передана role ігнорується), без пароля та хеша
### (випадкова пошта — щоб файл можна було проганяти повторно)
# @name registerUser
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "olena{{$randomInt 100000 999999}}@example.com",
  "password": "olena-password",
  "role": "admin"
}

### Реєстрація другого користувача (для перевірки чужих бронювань і токенів) → 201
# @name registerOther
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "taras{{$randomInt 100000 999999}}@example.com",
  "password": "taras-password"
}

### Помилка: пошта вже існує → 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "another-password"
}

### Помилка: неправильний формат пошти → 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "long-enough-password"
}

### Помилка: пароль коротший за 8 символів → 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "short{{$randomInt 100000 999999}}@example.com",
  "password": "1234567"
}

### Вхід адміністратора (створений `npm run seed`) → 200, { accessToken, refreshToken }
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Вхід користувача → 200
# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "olena-password"
}

### Вхід другого користувача → 200
# @name loginOther
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{registerOther.response.body.$.email}}",
  "password": "taras-password"
}

### Помилка: пошти не існує → 401 (повідомлення таке саме, як для неправильного пароля)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "olena-password"
}

### Помилка: неправильний пароль → 401 (те саме повідомлення)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "wrong-password"
}

### Поточний користувач → 200, { id, email, role }
GET {{baseUrl}}/auth/me
Authorization: Bearer {{userToken}}

### Помилка: без заголовка Authorization → 401
GET {{baseUrl}}/auth/me

### Помилка: зіпсований формат заголовка (без Bearer) → 401
GET {{baseUrl}}/auth/me
Authorization: {{userToken}}

### Помилка: недійсний підпис (токен змінено) → 401
GET {{baseUrl}}/auth/me
Authorization: Bearer {{userToken}}x

# Прострочений access-токен → теж 401 («Токен недійсний або застарілий»). Статично його не записати:
# постав ACCESS_TOKEN_TTL_MINUTES=1, перезапусти застосунок, увійди й повтори GET /auth/me за хвилину.

### Оновлення пари → 200, новий accessToken і новий refreshToken
# @name refreshUser
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{userRefreshToken}}"
}

### Помилка: старий refresh-токен уже використаний → 401
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{userRefreshToken}}"
}

### Помилка: refresh-токена немає в базі → 401
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "never-issued-token"
}

### Помилка: refreshToken відсутній у тілі → 400
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{}


######################## ФІЛЬМИ ########################

### Створити фільм → 201
# @name createFilm
POST {{baseUrl}}/films
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Тіні забутих предків",
  "durationMinutes": 97,
  "releaseYear": 1965
}

### Створити другий фільм (без сеансів, для успішного видалення) → 201
# @name createOtherFilm
POST {{baseUrl}}/films
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Земля",
  "durationMinutes": 75,
  "releaseYear": 1930
}

### Помилка: без токена → 401
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Без доступу",
  "durationMinutes": 90,
  "releaseYear": 2000
}

### Помилка: токен з роллю user → 403
POST {{baseUrl}}/films
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Без доступу",
  "durationMinutes": 90,
  "releaseYear": 2000
}

### Помилка: поле відсутнє → 400
POST {{baseUrl}}/films
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Без тривалості",
  "releaseYear": 2000
}

### Помилка: поле має неправильний тип → 400
POST {{baseUrl}}/films
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Неправильний тип",
  "durationMinutes": "довгий",
  "releaseYear": 2000
}

### Усі фільми → 200
GET {{baseUrl}}/films

### Один фільм → 200
GET {{baseUrl}}/films/{{filmId}}

### Помилка: фільму немає → 404
GET {{baseUrl}}/films/{{missingId}}

### Оновити фільм (часткове оновлення) → 200
PATCH {{baseUrl}}/films/{{filmId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "durationMinutes": 98
}

### Помилка: без токена → 401
PATCH {{baseUrl}}/films/{{filmId}}
Content-Type: application/json

{
  "durationMinutes": 99
}

### Помилка: токен з роллю user → 403
PATCH {{baseUrl}}/films/{{filmId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "durationMinutes": 99
}

### Помилка: неправильний тип поля при оновленні → 400
PATCH {{baseUrl}}/films/{{filmId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "releaseYear": "minulyi"
}

### Помилка: оновлення неіснуючого фільму → 404
PATCH {{baseUrl}}/films/{{missingId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Нема такого"
}


######################## ЗАЛИ ########################

### Створити зал 3 × 5 → 201 (випадковий номер у назві — щоб файл можна було проганяти повторно)
# @name createHall
POST {{baseUrl}}/halls
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Зал {{$randomInt 1000 9999}}",
  "rows": 3,
  "seatsPerRow": 5
}

### Створити другий зал (без сеансів, для успішного видалення) → 201
# @name createOtherHall
POST {{baseUrl}}/halls
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Камерний зал {{$randomInt 1000 9999}}",
  "rows": 2,
  "seatsPerRow": 4
}

### Помилка: без токена → 401
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Зал без доступу",
  "rows": 1,
  "seatsPerRow": 1
}

### Помилка: токен з роллю user → 403
POST {{baseUrl}}/halls
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Зал без доступу",
  "rows": 1,
  "seatsPerRow": 1
}

### Помилка: зал з такою назвою вже існує → 409
POST {{baseUrl}}/halls
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{hallName}}",
  "rows": 10,
  "seatsPerRow": 10
}

### Помилка: поле відсутнє → 400
POST {{baseUrl}}/halls
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Зал без рядів",
  "seatsPerRow": 10
}

### Помилка: число не є цілим додатним → 400
POST {{baseUrl}}/halls
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Дивний зал",
  "rows": 2.5,
  "seatsPerRow": -3
}

### Усі зали → 200
GET {{baseUrl}}/halls

### Зал з переліком місць (15 елементів) → 200
GET {{baseUrl}}/halls/{{hallId}}

### Помилка: залу немає → 404
GET {{baseUrl}}/halls/{{missingId}}


######################## СЕАНСИ ########################

### Створити сеанс завтра → 201
# @name createShowing
POST {{baseUrl}}/showings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "{{$datetime iso8601 1 d}}",
  "price": 12500
}

### Створити ще один сеанс того самого фільму післязавтра → 201
POST {{baseUrl}}/showings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "{{$datetime iso8601 2 d}}",
  "price": 9000
}

### Помилка: без токена → 401
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "{{$datetime iso8601 3 d}}",
  "price": 10000
}

### Помилка: токен з роллю user → 403
POST {{baseUrl}}/showings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "{{$datetime iso8601 3 d}}",
  "price": 10000
}

### Помилка: фільму з таким id немає → 400
POST {{baseUrl}}/showings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "filmId": "{{missingId}}",
  "hallId": "{{hallId}}",
  "startsAt": "{{$datetime iso8601 1 d}}",
  "price": 12500
}

### Помилка: залу з таким id немає → 400
POST {{baseUrl}}/showings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{missingId}}",
  "startsAt": "{{$datetime iso8601 1 d}}",
  "price": 12500
}

### Помилка: startsAt не є коректною датою ISO 8601 → 400
POST {{baseUrl}}/showings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "завтра о сьомій",
  "price": 12500
}

### Помилка: startsAt у минулому → 400
POST {{baseUrl}}/showings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "2020-01-01T18:00:00Z",
  "price": 12500
}

### Помилка: price не є цілим додатним числом → 400
POST {{baseUrl}}/showings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "{{$datetime iso8601 1 d}}",
  "price": 125.5
}

### Усі сеанси: перша сторінка { items, total, page: 1, limit: 20 } (за часом початку, потім за id) → 200
GET {{baseUrl}}/showings

### Пагінація: друга сторінка по одному сеансу → 200
GET {{baseUrl}}/showings?page=2&limit=1

### Сортування: найпізніші сеанси першими → 200
GET {{baseUrl}}/showings?sort=desc

### Сеанси фільму → 200
GET {{baseUrl}}/showings?filmId={{filmId}}

### Сеанси фільму на добу завтрашнього сеансу (UTC) → 200
GET {{baseUrl}}/showings?filmId={{filmId}}&date={{$datetime 'YYYY-MM-DD' 1 d}}

### Помилка: date не відповідає формату YYYY-MM-DD → 400
GET {{baseUrl}}/showings?date=01.12.2030

### Помилка: filmId не є UUID → 400
GET {{baseUrl}}/showings?filmId=abc

### Помилка: page менше 1 → 400
GET {{baseUrl}}/showings?page=0

### Помилка: page не ціле → 400
GET {{baseUrl}}/showings?page=1.5

### Помилка: limit більше 100 → 400
GET {{baseUrl}}/showings?limit=101

### Помилка: limit не число → 400
GET {{baseUrl}}/showings?limit=ten

### Помилка: sort не asc і не desc → 400
GET {{baseUrl}}/showings?sort=up

### Один сеанс з назвами фільму й залу → 200
GET {{baseUrl}}/showings/{{showingId}}

### Помилка: сеансу немає → 404
GET {{baseUrl}}/showings/{{missingId}}

### Місця сеансу з ознакою зайнятості (усі вільні) → 200
GET {{baseUrl}}/showings/{{showingId}}/seats

### Помилка: місця неіснуючого сеансу → 404
GET {{baseUrl}}/showings/{{missingId}}/seats


######################## БРОНЮВАННЯ ########################

### Забронювати два місця → 201, totalPrice = 25000; userId — з токена, поле з тіла ігнорується
# @name createBooking
POST {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "userId": "{{missingId}}",
  "seats": [
    { "row": 1, "seat": 4 },
    { "row": 1, "seat": 5 }
  ]
}

### Бронювання другого користувача (адміністратор скасує його нижче) → 201
# @name createOtherBooking
POST {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "seats": [
    { "row": 3, "seat": 1 }
  ]
}

### Помилка: без токена → 401
POST {{baseUrl}}/showings/{{showingId}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 3, "seat": 2 }
  ]
}

### Помилка: одне з місць уже заброньоване → 409
### Транзакція відкочується: ряд 2 місце 1 НЕ бронюється, нового бронювання в БД немає
POST {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "seats": [
    { "row": 2, "seat": 1 },
    { "row": 1, "seat": 5 }
  ]
}

### Помилка: порожній масив seats → 400
POST {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "seats": []
}

### Помилка: елемент не містить обох чисел → 400
POST {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "seats": [
    { "row": 2 }
  ]
}

### Помилка: одне й те саме місце в масиві двічі → 400
POST {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "seats": [
    { "row": 3, "seat": 3 },
    { "row": 3, "seat": 3 }
  ]
}

### Помилка: номер ряду перевищує rows → 400
POST {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "seats": [
    { "row": 4, "seat": 1 }
  ]
}

### Помилка: номер місця перевищує seatsPerRow → 400
POST {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "seats": [
    { "row": 1, "seat": 6 }
  ]
}

### Помилка: число не є цілим додатним → 400
POST {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "seats": [
    { "row": 0, "seat": 1.5 }
  ]
}

### Помилка: бронювання на неіснуючий сеанс → 404
POST {{baseUrl}}/showings/{{missingId}}/bookings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "seats": [
    { "row": 1, "seat": 1 }
  ]
}

### Місця сеансу: ряд 1 місця 4 і 5 зайняті, ряд 2 місце 1 вільне → 200
GET {{baseUrl}}/showings/{{showingId}}/seats

### Бронювання сеансу → 200
GET {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{adminToken}}

### Помилка: без токена → 401
GET {{baseUrl}}/showings/{{showingId}}/bookings

### Помилка: токен з роллю user → 403
GET {{baseUrl}}/showings/{{showingId}}/bookings
Authorization: Bearer {{userToken}}

### Помилка: бронювання неіснуючого сеансу → 404
GET {{baseUrl}}/showings/{{missingId}}/bookings
Authorization: Bearer {{adminToken}}

### Усі бронювання (адміністратор) → 200
GET {{baseUrl}}/bookings
Authorization: Bearer {{adminToken}}

### Помилка: без токена → 401
GET {{baseUrl}}/bookings

### Помилка: токен з роллю user → 403
GET {{baseUrl}}/bookings
Authorization: Bearer {{userToken}}

### Мої бронювання з даними сеансу → 200
GET {{baseUrl}}/bookings/my
Authorization: Bearer {{userToken}}

### Мої бронювання другого користувача: чужих не видно → 200
GET {{baseUrl}}/bookings/my
Authorization: Bearer {{otherToken}}

### Помилка: без токена → 401
GET {{baseUrl}}/bookings/my



######################## ВИДАЛЕННЯ ########################

### Помилка: на фільм посилається сеанс → 409
DELETE {{baseUrl}}/films/{{filmId}}
Authorization: Bearer {{adminToken}}

### Помилка: на зал посилається сеанс → 409
DELETE {{baseUrl}}/halls/{{hallId}}
Authorization: Bearer {{adminToken}}

### Помилка: без токена → 401
DELETE {{baseUrl}}/films/{{otherFilmId}}

### Помилка: токен з роллю user → 403
DELETE {{baseUrl}}/films/{{otherFilmId}}
Authorization: Bearer {{userToken}}

### Видалити фільм без сеансів → 204
DELETE {{baseUrl}}/films/{{otherFilmId}}
Authorization: Bearer {{adminToken}}

### Помилка: фільм уже видалено → 404
DELETE {{baseUrl}}/films/{{otherFilmId}}
Authorization: Bearer {{adminToken}}

### Помилка: без токена → 401
DELETE {{baseUrl}}/halls/{{otherHallId}}

### Помилка: токен з роллю user → 403
DELETE {{baseUrl}}/halls/{{otherHallId}}
Authorization: Bearer {{userToken}}

### Видалити зал без сеансів → 204
DELETE {{baseUrl}}/halls/{{otherHallId}}
Authorization: Bearer {{adminToken}}

### Помилка: зал уже видалено → 404
DELETE {{baseUrl}}/halls/{{otherHallId}}
Authorization: Bearer {{adminToken}}

### Помилка: без токена → 401
DELETE {{baseUrl}}/bookings/{{bookingId}}

### Помилка: чуже бронювання (другий користувач) → 403
DELETE {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{otherToken}}

### Скасувати своє бронювання → 204
DELETE {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{userToken}}

### Помилка: бронювання вже скасоване → 404
DELETE {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{userToken}}

### Адміністратор скасовує чуже бронювання → 204
DELETE {{baseUrl}}/bookings/{{otherBookingId}}
Authorization: Bearer {{adminToken}}

### Після скасування ряд 1 місця 4–5 і ряд 3 місце 1 знову вільні → 200
GET {{baseUrl}}/showings/{{showingId}}/seats


######################## ВИХІД ########################

### Помилка: вихід без access-токена → 401
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}

### Помилка: refresh-токен належить іншому користувачу → 404 (і він лишається дійсним)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "refreshToken": "{{otherRefreshToken}}"
}

### Вихід: відкликати власний refresh-токен → 204
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}

### Помилка: токен уже відкликано → 404
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}

### Помилка: відкликаний refresh-токен більше не оновлює пару → 401
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}
